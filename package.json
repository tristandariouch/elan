{
  "name": "elan",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "bun run typecheck && vite build",
    "build:pages": "bun run build && bun scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "start": "bun run build && bun scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "bun test tests",
    "test:ui": "bun scripts/check-ui.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:ui && bun run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-router": "1.120.5",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22.12.0"
  }
}
